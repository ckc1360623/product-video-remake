{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-video-remake/request-bundle.schema.json",
  "title": "Compiled Seedance Request Bundle",
  "type": "object",
  "required": ["schema_version", "contract", "prompt", "upload_manifest", "api_request"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "contract": {
      "type": "object",
      "required": ["generation_call_count", "segmented_generation", "post_editing", "video_assembly"],
      "properties": {
        "generation_call_count": {"const": 1},
        "segmented_generation": {"const": false},
        "post_editing": {"const": false},
        "video_assembly": {"const": false}
      },
      "additionalProperties": false
    },
    "prompt": {"type": "string", "minLength": 1},
    "upload_manifest": {
      "type": "object",
      "required": ["schema_version", "assets"],
      "properties": {
        "schema_version": {"const": "1.3"},
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": ["asset_id", "source", "api_placeholder", "content_type", "role", "prompt_reference_name"],
            "properties": {
              "asset_id": {"type": "string"},
              "source": {"type": "string"},
              "api_placeholder": {"type": "string"},
              "content_type": {"const": "image_url"},
              "role": {"const": "reference_image"},
              "prompt_reference_name": {"type": "string"},
              "requires_upload": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "api_request": {
      "type": "object",
      "required": ["model", "content", "resolution", "ratio", "duration", "generate_audio", "seed", "watermark"],
      "properties": {
        "model": {"type": "string"},
        "content": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "text"],
                "properties": {
                  "type": {"const": "text"},
                  "text": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "image_url", "role"],
                "properties": {
                  "type": {"const": "image_url"},
                  "image_url": {
                    "type": "object",
                    "required": ["url"],
                    "properties": {"url": {"type": "string", "minLength": 1}},
                    "additionalProperties": false
                  },
                  "role": {"const": "reference_image"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "resolution": {"enum": ["480p", "720p", "1080p"]},
        "ratio": {"enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"]},
        "duration": {"type": "integer", "minimum": 4, "maximum": 15},
        "generate_audio": {"type": "boolean"},
        "seed": {"type": "integer", "minimum": -1, "maximum": 4294967295},
        "watermark": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
