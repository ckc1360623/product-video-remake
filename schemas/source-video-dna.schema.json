{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-video-remake/source-video-dna.schema.json",
  "title": "Source Video DNA",
  "type": "object",
  "required": ["schema_version", "source_asset", "media", "summary", "audio", "shots", "source_elements"],
  "properties": {
    "schema_version": {"enum": ["1.2", "1.3"]},
    "source_asset": {
      "type": "object",
      "required": ["asset_id", "source"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "analysis_cache_key": {"type": "string", "minLength": 1},
        "analysis_strategy_version": {"type": "string", "minLength": 1},
        "source_signature": {
          "type": "object",
          "required": ["resolved_path", "size", "mtime_ns"],
          "properties": {
            "resolved_path": {"type": "string", "minLength": 1},
            "size": {"type": "integer", "minimum": 1},
            "mtime_ns": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "required": ["duration_ms"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "ratio": {"type": "string"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "has_audio": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "summary": {"type": "object"},
    "audio": {"type": "object"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_start_ms", "source_end_ms", "description", "narrative_role"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_start_ms": {"type": "integer", "minimum": 0},
          "source_end_ms": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "narrative_role": {"type": "string", "minLength": 1},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "must_keep": {"type": "boolean"},
          "signature": {"type": "boolean"},
          "camera": {"type": ["object", "string"]},
          "composition": {"type": ["object", "string"]},
          "subjects": {"type": ["array", "object", "string"]},
          "states": {"type": ["object", "array", "string"]},
          "product": {"type": ["object", "string"]},
          "scene": {"type": ["object", "string"]},
          "audio": {"type": ["object", "string"]},
          "text_overlays": {"type": ["array", "string"]},
          "transition_out": {"type": ["object", "string"]}
        },
        "additionalProperties": true
      }
    },
    "source_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "must_keep"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "must_keep": {"type": "boolean"},
          "source_shot_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
