{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-video-remake/product-profile.schema.json",
  "title": "Product Profile",
  "type": "object",
  "required": ["schema_version", "source_images", "identity", "visual_identity"],
  "properties": {
    "schema_version": {"enum": ["1.2", "1.3"]},
    "source_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["asset_id", "source"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "identity": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "name": {"$ref": "#/$defs/evidenceValue"},
        "brand": {"$ref": "#/$defs/evidenceValue"},
        "category": {"$ref": "#/$defs/evidenceValue"}
      },
      "additionalProperties": true
    },
    "visual_identity": {"type": "object"},
    "usage": {"type": "object"},
    "selling_points": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceValue"}
    },
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceValue": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "source": {"enum": ["observed", "inferred", "user_confirmed", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
