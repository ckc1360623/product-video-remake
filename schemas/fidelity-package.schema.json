{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-video-remake/fidelity-package.schema.json",
  "title": "High-fidelity Segmented Package Manifest",
  "type": "object",
  "required": ["schema_version", "mode", "generation_call_count", "ready", "segments", "external_actions_executed"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "mode": {"const": "high_fidelity_segmented"},
    "generation_call_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "ready": {"type": "boolean"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["segment_number", "directory", "ready", "global_start_ms", "global_end_ms"],
        "properties": {
          "segment_number": {"type": "integer", "minimum": 1},
          "directory": {"type": "string"},
          "ready": {"type": "boolean"},
          "global_start_ms": {"type": "integer", "minimum": 0},
          "global_end_ms": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "external_actions_executed": {"const": false}
  },
  "additionalProperties": false
}
